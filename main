  /* ══════════════════════════════════════════
     NAVIGATION
  ══════════════════════════════════════════ */
  const PAGE_TITLES = {
    dash: 'Dashboard',
    crm:  'CRM — Customers',
    pol:  'Policy Management',
    acc:  'Accounting',
    rep:  'Reports',
  };

  function go(name) {
    document.querySelectorAll('.module').forEach(m => m.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
    document.getElementById('m-' + name).classList.add('active');
    document.getElementById('n-' + name).classList.add('active');
    document.getElementById('page-title').textContent = PAGE_TITLES[name];
  }

  /* ══════════════════════════════════════════
     THEME
  ══════════════════════════════════════════ */
  let isDark = false;
  function toggleTheme() {
    isDark = !isDark;
    document.documentElement.setAttribute('data-theme', isDark ? 'dark' : '');
    document.getElementById('theme-icon').className = isDark ? 'ti ti-moon' : 'ti ti-sun';
  }

  /* ══════════════════════════════════════════
     HELPERS
  ══════════════════════════════════════════ */
  function fmt(n) { return Math.round(n).toLocaleString('en-IN'); }
  function initials(name) { return name.split(' ').map(w => w[0]).join('').toUpperCase(); }

  /* ══════════════════════════════════════════
     ACTIVITY FEED
  ══════════════════════════════════════════ */
  document.getElementById('activity-feed').innerHTML = DATA.activity.map(a => `
    <div class="act-row">
      <div class="act-dot" style="background:${a.color}"></div>
      <div style="flex:1">
        <div style="font-size:12.5px;font-weight:500;color:var(--text-primary)">${a.title}</div>
        <div style="font-size:11px;color:var(--text-secondary)">${a.desc}</div>
      </div>
      <span style="font-size:11px;color:var(--text-tertiary);white-space:nowrap">${a.time}</span>
    </div>
  `).join('');

  /* ══════════════════════════════════════════
     CRM
  ══════════════════════════════════════════ */
  function renderCustomers(data) {
    document.getElementById('crm-tbody').innerHTML = data.map(c => `
      <tr>
        <td>
          <div style="display:flex;align-items:center;gap:9px">
            <div style="width:28px;height:28px;border-radius:50%;background:var(--accent-bg);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:var(--accent-text);flex-shrink:0">${initials(c.name)}</div>
            <div>
              <div style="font-weight:500;font-size:12.5px">${c.name}</div>
              <div style="font-size:10px;color:var(--text-secondary)">${c.id}</div>
            </div>
          </div>
        </td>
        <td>${c.phone}</td>
        <td style="color:var(--accent-text)">${c.email}</td>
        <td>${c.city}</td>
        <td><span class="badge ${c.kyc === 'Verified' ? 'badge-success' : 'badge-warning'}">${c.kyc}</span></td>
        <td style="text-align:center;font-weight:500">${c.policies}</td>
        <td>
          <button onclick="alert('Edit customer: ${c.name}')" title="Edit" style="padding:4px 8px;font-size:11px"><i class="ti ti-edit"></i></button>
          <button onclick="deleteCustomer('${c.id}')" title="Delete" style="padding:4px 8px;font-size:11px;margin-left:4px;color:var(--danger-text)"><i class="ti ti-trash"></i></button>
        </td>
      </tr>
    `).join('');
  }
  renderCustomers(DATA.customers);

  function filterCustomers() {
    const q = document.getElementById('crmQ').value.toLowerCase();
    renderCustomers(DATA.customers.filter(c =>
      c.name.toLowerCase().includes(q) ||
      c.city.toLowerCase().includes(q) ||
      c.email.toLowerCase().includes(q)
    ));
  }

  function toggleCrmForm() {
    const f = document.getElementById('crmForm');
    f.style.display = f.style.display === 'none' ? 'block' : 'none';
  }

  function addCustomer() {
    const name = document.getElementById('f-name').value.trim();
    if (!name) { alert('Name is required.'); return; }
    DATA.customers.push({
      id: 'C00' + (DATA.customers.length + 1),
      name,
      phone: document.getElementById('f-phone').value || '—',
      email: document.getElementById('f-email').value || '—',
      city:  document.getElementById('f-city').value  || '—',
      kyc:   'Pending',
      policies: 0,
    });
    renderCustomers(DATA.customers);
    toggleCrmForm();
    ['f-name','f-phone','f-email','f-city','f-kyc','f-addr'].forEach(id => {
      document.getElementById(id).value = '';
    });
  }

  function deleteCustomer(id) {
    if (!confirm('Delete this customer?')) return;
    const i = DATA.customers.findIndex(c => c.id === id);
    if (i !== -1) { DATA.customers.splice(i, 1); renderCustomers(DATA.customers); }
  }

  /* ══════════════════════════════════════════
     POLICIES
  ══════════════════════════════════════════ */
  function renderPolicies(data) {
    document.getElementById('pol-tbody').innerHTML = data.map(p => {
      const comm = Math.round(p.prem * p.cp / 100);
      const gst  = Math.round(comm * 0.18);
      const net  = comm - gst;
      return `<tr>
        <td style="font-weight:600;color:var(--accent-text)">${p.no}</td>
        <td>${p.cust}</td>
        <td>${p.ins}</td>
        <td><span class="badge badge-info">${p.type}</span></td>
        <td style="text-align:right">₹${fmt(p.prem)}</td>
        <td style="text-align:center">${p.cp}%</td>
        <td style="text-align:right;color:var(--success-text);font-weight:500">₹${fmt(comm)}</td>
        <td style="text-align:right;color:var(--warning-text)">₹${fmt(gst)}</td>
        <td style="text-align:right;font-weight:600">₹${fmt(net)}</td>
        <td><span class="badge ${p.status === 'Active' ? 'badge-success' : 'badge-warning'}">${p.status}</span></td>
      </tr>`;
    }).join('');
  }
  renderPolicies(DATA.policies);

  function filterPolicies() {
    const q = document.getElementById('polQ').value.toLowerCase();
    renderPolicies(DATA.policies.filter(p =>
      p.no.toLowerCase().includes(q) ||
      p.cust.toLowerCase().includes(q) ||
      p.ins.toLowerCase().includes(q)
    ));
  }

  /* ══════════════════════════════════════════
     ACCOUNTING
  ══════════════════════════════════════════ */
  document.getElementById('journal-tbody').innerHTML = DATA.journals.map(j => `
    <tr>
      <td style="color:var(--text-secondary);white-space:nowrap">${j.dt}</td>
      <td>${j.desc}</td>
      <td style="text-align:right;color:var(--success-text);font-weight:500">${j.dr ? '₹' + fmt(j.dr) : '—'}</td>
      <td style="text-align:right;color:var(--danger-text);font-weight:500">${j.cr ? '₹' + fmt(j.cr) : '—'}</td>
    </tr>
  `).join('');

  document.getElementById('ledger-tbody').innerHTML = DATA.ledger.map(l => `
    <tr>
      <td style="font-weight:500">${l.acc}</td>
      <td><span class="badge ${l.cls}">${l.type}</span></td>
      <td style="text-align:right;font-weight:600">₹${l.bal}</td>
    </tr>
  `).join('');

  /* ══════════════════════════════════════════
