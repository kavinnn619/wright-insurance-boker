  /* ══════════════════════════════════════════
     REPORTS — GST
  ══════════════════════════════════════════ */
  document.getElementById('gst-tbody').innerHTML = `
    <tr><td>Output GST (18% on commission)</td><td style="text-align:right;color:var(--warning-text)">₹1,31,220</td></tr>
    <tr><td>Input GST (on purchases)</td><td style="text-align:right;color:var(--success-text)">₹18,000</td></tr>
    <tr class="tr-total"><td>Net GST Payable</td><td style="text-align:right;color:var(--warning-text)">₹1,13,220</td></tr>
    <tr class="tr-section"><td colspan="2">Monthly — Q4 FY25</td></tr>
    <tr><td style="padding-left:16px;font-size:11px">January 2025</td><td style="text-align:right;font-size:11px">₹39,000</td></tr>
    <tr><td style="padding-left:16px;font-size:11px">February 2025</td><td style="text-align:right;font-size:11px">₹33,300</td></tr>
    <tr><td style="padding-left:16px;font-size:11px">March 2025</td><td style="text-align:right;font-size:11px">₹40,920</td></tr>
  `;

  /* ══════════════════════════════════════════
     REPORTS — Customer Revenue
  ══════════════════════════════════════════ */
  const byCust = {};
  DATA.policies.forEach(p => {
    if (!byCust[p.cust]) byCust[p.cust] = { n: 0, prem: 0, comm: 0 };
    byCust[p.cust].n++;
    byCust[p.cust].prem += p.prem;
    byCust[p.cust].comm += p.prem * p.cp / 100;
  });
  const totalComm = Object.values(byCust).reduce((s, v) => s + v.comm, 0);

  document.getElementById('crev-tbody').innerHTML = Object.entries(byCust).map(([name, d]) => {
    const gst  = Math.round(d.comm * 0.18);
    const net  = Math.round(d.comm) - gst;
    const pct  = ((d.comm / totalComm) * 100).toFixed(1);
    return `<tr>
      <td style="font-weight:500">${name}</td>
      <td style="text-align:center">${d.n}</td>
      <td style="text-align:right">₹${fmt(d.prem)}</td>
      <td style="text-align:right;color:var(--success-text);font-weight:500">₹${fmt(d.comm)}</td>
      <td style="text-align:right;color:var(--warning-text)">₹${gst.toLocaleString('en-IN')}</td>
      <td style="text-align:right;font-weight:600">₹${net.toLocaleString('en-IN')}</td>
      <td>
        <div style="display:flex;align-items:center;gap:8px">
          <div class="prog-bar"><div class="prog-fill filled" style="width:${pct}%"></div></div>
          <span style="font-size:11px;color:var(--text-secondary);min-width:32px">${pct}%</span>
        </div>
      </td>
    </tr>`;
  }).join('');

  /* ══════════════════════════════════════════
     CHARTS
  ══════════════════════════════════════════ */
  const MONTHS = ['Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar'];
  const GC = 'rgba(0,0,0,0.05)';
  const TC = '#999';

  // Revenue chart
  new Chart(document.getElementById('revChart'), {
    type: 'bar',
    data: {
      labels: MONTHS,
      datasets: [{
        label: 'Revenue (₹L)',
        data: [4.2, 3.8, 5.1, 4.6, 5.8, 4.9, 6.2, 5.5, 4.8, 6.8, 5.2, 7.3],
        backgroundColor: '#378ADD',
        borderRadius: 5,
        borderSkipped: false,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: GC }, ticks: { color: TC, font: { size: 10 } } },
        y: { grid: { color: GC }, ticks: { color: TC, font: { size: 10 }, callback: v => '₹' + v + 'L' } }
      }
    }
  });

  // Expense chart
  new Chart(document.getElementById('expChart'), {
    type: 'doughnut',
    data: {
      labels: ['Salaries', 'Office', 'Marketing'],
      datasets: [{
        data: [55, 25, 20],
        backgroundColor: ['#378ADD', '#639922', '#EF9F27'],
        borderWidth: 0,
        hoverOffset: 6,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      cutout: '72%',
      plugins: { legend: { display: false } }
    }
  });

  // Commission trend chart
  new Chart(document.getElementById('commChart'), {
    type: 'line',
    data: {
      labels: MONTHS,
      datasets: [{
        label: 'Commission (₹K)',
        data: [63, 57, 76, 69, 87, 73, 93, 82, 72, 102, 78, 109],
        borderColor: '#639922',
        backgroundColor: 'rgba(99,153,34,0.08)',
        fill: true,
        tension: 0.4,
        pointRadius: 3,
        pointBackgroundColor: '#639922',
        pointBorderWidth: 0,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: GC }, ticks: { color: TC, font: { size: 10 } } },
        y: { grid: { color: GC }, ticks: { color: TC, font: { size: 10 }, callback: v => '₹' + v + 'K' } }
      }
    }
  });
</script>
